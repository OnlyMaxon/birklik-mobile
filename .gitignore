# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
# Шаблон со звёздочкой намеренно: Expo читает не только .env, но и
# .env.development с .env.production. Точечный список однажды промахнётся.
.env*
!.env.example

# Конфигурация Firebase. Не секрет в строгом смысле — те же значения лежат в
# собранном приложении, — но и в открытом репозитории ей делать нечего.
# Скачивается из консоли Firebase, для сборок EAS загружается отдельным файлом.
google-services.json
GoogleService-Info.plist

# typescript
*.tsbuildinfo

example

# generated native folders
/ios
/android

# Собранные пакеты приложения — их место в EAS, а не в репозитории
*.apk
*.aab
*.ipa
keystore.properties

# Ключи Apple. ⚠️ Папка закрыта ЦЕЛИКОМ, а не по расширениям: рядом с `.p8`
# владелец положил текстовый файл с Issuer ID, и шаблон `*.p8` его не покрывал —
# он показывался как неотслеживаемый и уехал бы в коммит с первым `git add -A`.
# Закрывать по расширениям здесь нельзя: что ляжет рядом в следующий раз,
# заранее неизвестно.
#
# ⚠️ Лучше, чтобы этой папки в репозитории не было вовсе: игнорирование —
# одна правка от беды, а ключ можно отозвать только вручную в Apple.
Keys/
