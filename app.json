{
  "expo": {
    "name": "Birklik.az",
    "slug": "birklik-mobile",
    "version": "1.0.15",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "birklik",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "az.birklik.app",
      "supportsTablet": false,
      "icon": "./assets/images/icon-ios.png",
      "buildNumber": "2",
      "associatedDomains": [
        "applinks:birklik.az"
      ],
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSPhotoLibraryUsageDescription": "Elanınıza şəkil əlavə etmək üçün Birklik.az foto kitabxananıza giriş istəyir.",
        "NSLocationWhenInUseUsageDescription": "Xəritəni yaxınlığınızda göstərmək üçün yerləşmə icazəsi istənilə bilər. Birklik.az yerləşmənizi toplamır və saxlamır."
      }
    },
    "android": {
      "package": "az.birklik.app",
      "versionCode": 17,
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#ffffff",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ],
          "data": [
            {
              "scheme": "https",
              "host": "birklik.az",
              "pathPrefix": "/property/"
            },
            {
              "scheme": "https",
              "host": "birklik.az",
              "pathPrefix": "/az/property/"
            },
            {
              "scheme": "https",
              "host": "birklik.az",
              "pathPrefix": "/ru/property/"
            },
            {
              "scheme": "https",
              "host": "birklik.az",
              "pathPrefix": "/en/property/"
            },
            {
              "scheme": "http",
              "host": "birklik.az",
              "pathPrefix": "/property/"
            },
            {
              "scheme": "http",
              "host": "birklik.az",
              "pathPrefix": "/az/property/"
            },
            {
              "scheme": "http",
              "host": "birklik.az",
              "pathPrefix": "/ru/property/"
            },
            {
              "scheme": "http",
              "host": "birklik.az",
              "pathPrefix": "/en/property/"
            }
          ]
        }
      ],
      "predictiveBackGestureEnabled": false,
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "locales": {
      "az": "./assets/locales/az.json",
      "ru": "./assets/locales/ru.json",
      "en": "./assets/locales/en.json"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#ffffff",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 150
        }
      ],
      [
        "@react-native-firebase/app",
        {
          "ios": {
            "disableSPM": true
          }
        }
      ],
      "@react-native-firebase/auth",
      "@react-native-firebase/messaging",
      "@react-native-firebase/app-check",
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static"
          }
        }
      ],
      "expo-dev-client",
      "expo-localization",
      "@maplibre/maplibre-react-native",
      "expo-iap"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "5423d87b-91de-44a1-b297-ddd2058a407e"
      }
    },
    "owner": "onlymaxons-team"
  }
}
